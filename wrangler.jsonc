{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mvb-aprovacao",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "services": [
    {
      "binding": "CONTENT",
      "service": "mvb-aprovacao-arquivos"
    }
  ]
}
