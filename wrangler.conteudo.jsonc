{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mvb-aprovacao-arquivos",
  "main": "src/content-worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.rounds/bundle",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
